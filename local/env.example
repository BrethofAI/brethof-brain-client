# Copy to .env and fill in. NEVER commit the filled copy.
# The passphrase that unlocks the memory. We never see it and cannot recover
# it: lose it and the data is gone, which is the point.
BRAIN_PASSPHRASE=
# Where the CIPHERTEXT lives on your disk. This is the backup unit.
BRAIN_DATA_DIR=./data
# The fp32 ONNX EmbeddingGemma export. install.sh downloads it here —
# only change this if you keep the model somewhere else.
BRAIN_MODEL_DIR=./model/embeddinggemma-300m-onnx
# Local port the MCP client connects to.
BRAIN_DB_PORT=15440
# Concurrent embeds. Set to your CPU core count. The code defaults to 3,
# which is OUR server's cap, not a sensible limit for your machine.
BRAIN_EMBED_SLOTS=4
# Postgres role password. Guards the connection between the two containers;
# this is NOT the passphrase above, which decrypts the disk itself.
BRAIN_DB_PASSWORD=
# Local port your agent connects to for /v1/mcp.
BRAIN_API_PORT=8610
# Where mint-key.sh wrote the key hash.
BRAIN_KEY_DIR=./keys
# Image version — install.sh writes and updates this; leave it alone.
BRAIN_VERSION=
# Your hub key, from brethof.ai/account. It connects this box to our hub,
# which reads each exchange, curates the memory, and composes the brief
# that opens every session and the records that arrive with every prompt.
# Without it this box still records everything and your agent's own
# search keeps working — memory is never held hostage to a subscription.
BRAIN_HUB_KEY=
# PODMAN USERS ONLY (and only with systemd-resolved). A custom podman network
# gives containers no upstream DNS, so the box cannot resolve our hub and the
# licence appears broken when the fault is name resolution. Set your
# resolver(s) here, comma-separated. Docker users leave this empty.
BRAIN_DNS=
