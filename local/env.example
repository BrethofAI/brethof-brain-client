# Copy to .env and fill in. NEVER commit the filled copy.
# The passphrase that unlocks the memory. We never see it and cannot recover
# it: lose it and the data is gone, which is the point.
BRAIN_PASSPHRASE=
# Where the CIPHERTEXT lives on your disk. This is the backup unit.
BRAIN_DATA_DIR=./data
# The fp32 ONNX EmbeddingGemma export. install.sh downloads it here —
# only change this if you keep the model somewhere else.
BRAIN_MODEL_DIR=./model/embeddinggemma-300m-onnx
# Local port the MCP client connects to.
BRAIN_DB_PORT=15440
# Concurrent embeds. Set to your CPU core count. The code defaults to 3,
# which is OUR server's cap, not a sensible limit for your machine.
BRAIN_EMBED_SLOTS=4
# Postgres role password. Guards the connection between the two containers;
# this is NOT the passphrase above, which decrypts the disk itself.
BRAIN_DB_PASSWORD=
# Local port your agent connects to for /v1/mcp.
BRAIN_API_PORT=8610
# Where mint-key.sh wrote the key hash.
BRAIN_KEY_DIR=./keys
# Image version — install.sh writes and updates this; leave it alone.
BRAIN_VERSION=
# Your subscription key, from brethof.ai/account. It buys the judgment
# prompts (merging near-duplicates, healing). Recall and archiving work
# without it — memory is never held hostage to a subscription.
BRAIN_HUB_KEY=
# Curated records changed since the last heal before your agent is offered one.
BRAIN_HEAL_THRESHOLD=40
# PODMAN USERS ONLY (and only with systemd-resolved). A custom podman network
# gives containers no upstream DNS, so the box cannot resolve our hub and the
# licence appears broken when the fault is name resolution. Set your
# resolver(s) here, comma-separated. Docker users leave this empty.
BRAIN_DNS=

# WHO DOES THE THINKING — your agent, or a model you point us at.
#
# Curating a piece of conversation, resolving a near-duplicate and checking
# for drift are judgment jobs. By default they are offered to the agent in
# your own harness (it picks them up with next_task), which means they are
# paid for with your best model's tokens.
#
# Set these three and the container does that work itself, against ANY
# OpenAI-compatible endpoint — so the cheap model does the bookkeeping while
# the expensive one does your real work. Leave them empty and nothing
# changes: the work goes to your agent as before.
#
#   local runner:  BRAIN_INFERENCE_URL=http://host.containers.internal:11434/v1
#   a provider:    BRAIN_INFERENCE_URL=https://api.example.com/v1
#
# A LOCAL endpoint keeps the property that nothing leaves this machine.
# A REMOTE one does not — the conversation piece goes to whoever you point
# at. Your call, but make it knowingly. Either way it never comes to us.
#
# Set BOTH url and model, or neither; a url with no model is ignored and
# says so in the log.
BRAIN_INFERENCE_URL=
BRAIN_INFERENCE_MODEL=
BRAIN_INFERENCE_KEY=

# WHO HEALS YOUR MEMORY — your choice, made here, by you. Heal is the tidy-up
# that runs when a session compacts: it folds duplicate records and keeps the
# graph honest. It is the ONE job that must READ your curated records, so you
# decide whose model reads them. Three options:
#
#   BRAIN_HEAL_MODE=agent     (default) Heal is offered to the agent in your
#                             own harness when enough has changed. Nothing
#                             runs by itself; nothing leaves this machine.
#
#   BRAIN_HEAL_MODE=own       Your endpoint above (BRAIN_INFERENCE_URL/MODEL/
#                             KEY) heals automatically at every compact. Your
#                             tokens, your privacy terms — local endpoint
#                             means nothing leaves the machine at all.
#
#   BRAIN_HEAL_MODE=brethof   WE heal for you, automatically, on our hub.
#                             READ THIS BEFORE CHOOSING IT: this is the one
#                             option where we can read your memory — the
#                             curated-record batches heal examines are sent
#                             to our hub, judged in memory on a provider
#                             with a stated no-retention policy, and never
#                             stored. Your chat history is NEVER sent. If
#                             you accept that, copy the consent line below
#                             into this file EXACTLY — without it, this mode
#                             refuses to run and falls back to `agent`:
#
#   BRAIN_HEAL_CONSENT=I agree that Brethof may read the curated records heal examines
BRAIN_HEAL_MODE=agent
BRAIN_HEAL_CONSENT=

# THE GRAPH ADD-ON — who builds the graph, if anyone. The memory works
# without it: records, ledger, recall, the archive, and the curator's
# "X replaced Y" warnings. The graph is the history on top — every thing
# a conversation touched, its kind, how things connect, when — built by a
# second reader of each exchange, on this box, where the archive and the
# graph both live. Paid work, so it is a switch:
#   BRAIN_GRAPH_MODE=off      (default) no graph worker.
#   BRAIN_GRAPH_MODE=own      your endpoint above reads each exchange for the
#                             graph. Your tokens, no bound; `python3 -m
#                             core.graph_backfill <project>` reads the archive.
#   BRAIN_GRAPH_MODE=brethof  our hub reads it on our key, metered as the
#                             SECOND MESSAGE of every exchange (the add-on
#                             must be on your plan). No consent line: the hub
#                             already reads every exchange for curation.
BRAIN_GRAPH_MODE=off
