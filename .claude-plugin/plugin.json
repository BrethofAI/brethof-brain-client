{
  "name": "brethof-brain",
  "displayName": "brethof-brain",
  "version": "1.2.3",
  "description": "Shared long-term memory for your AI agents — auto-recall at session start, auto-archive every turn, and the full memory toolset on demand — on your own memory container, local or hosted.",
  "author": {
    "name": "Brethof AI",
    "email": "hello@brethof.ai",
    "url": "https://brethof.ai/brain/"
  },
  "homepage": "https://brethof.ai/brain/",
  "repository": "https://github.com/BrethofAI/brethof-brain-client",
  "license": "LicenseRef-brethof-brain-Client-License",
  "keywords": ["memory", "mcp", "claude", "agents", "recall"],
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "brethof-brain API key",
      "description": "From brethof.ai/account -> brethof-brain tab (bmv2_...).",
      "sensitive": true,
      "required": true
    },
    "endpoint": {
      "type": "string",
      "title": "Data-plane endpoint",
      "description": "Leave as default unless self-hosting.",
      "default": "http://127.0.0.1:8610"
    },
    "project": {
      "type": "string",
      "title": "Default project",
      "description": "Default memory project for this account (per-directory mapping still works via ~/.brethof-brain/config.json).",
      "default": "global"
    }
  }
}
