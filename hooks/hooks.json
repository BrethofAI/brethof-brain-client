{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "BRETHOF_MIND_API_KEY=\"${user_config.api_key}\" BRETHOF_MIND_ENDPOINT=\"${user_config.endpoint}\" BRETHOF_MIND_DEFAULT_PROJECT=\"${user_config.project}\" \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hook_entry.py\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "BRETHOF_MIND_API_KEY=\"${user_config.api_key}\" BRETHOF_MIND_ENDPOINT=\"${user_config.endpoint}\" BRETHOF_MIND_DEFAULT_PROJECT=\"${user_config.project}\" \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hook_entry.py\" prompt-submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "BRETHOF_MIND_API_KEY=\"${user_config.api_key}\" BRETHOF_MIND_ENDPOINT=\"${user_config.endpoint}\" BRETHOF_MIND_DEFAULT_PROJECT=\"${user_config.project}\" \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hook_entry.py\" stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "BRETHOF_MIND_API_KEY=\"${user_config.api_key}\" BRETHOF_MIND_ENDPOINT=\"${user_config.endpoint}\" \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hook_entry.py\" pre-compact"
          }
        ]
      }
    ]
  }
}
